# ─── Supabase ────────────────────────────────────────────────
# Copy these from: Supabase Dashboard → Settings → API Keys

# Your project URL  (visible in the browser address bar on the Supabase dashboard)
# Example: https://qczuvdxsyroolfjfjpai.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Publishable / anon key  (safe to expose in the browser)
# Settings → API Keys → "Publishable key"  OR  Legacy tab → anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX

# Service-role / secret key  (server-only — NEVER expose in the browser)
# Settings → API Keys → "Secret keys" section  OR  Legacy tab → service_role key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXX

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
